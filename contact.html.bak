      <div class="footer-col">
        <h4>Donate</h4>
        <ul>
          <li><a href="donate.html">Donate</a></li>
          <li><a href="donate.html#where">Where your support goes</a></li>
          <li><a href="contact.html">Contact the team</a></li>
        </ul>
        <div style="margin-top:20px">
          <a class="btn btn-gold btn-sm" href="donate.html">Donate</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 Project Gullak. All rights reserved.</p>
      <p>Building financially confident futures.</p>
