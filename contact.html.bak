        <li><a class="nav-link" href="contact.html" aria-current="page">Contact</a></li>
      </ul>
    </nav>
    <div class="nav-actions">
      <!-- INSTAGRAM — replace href="#" with the profile URL when ready -->
      <a class="nav-social" href="https://www.instagram.com/projectgullak_" aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.1" cy="6.9" r="1.2" fill="currentColor" stroke="none"/></svg>
      </a>
      <a class="btn btn-gold btn-sm" href="donate.html">Donate</a>
